{
  "manifest_version": 3,
  "name": "Alpha Impact",
  "version": "0.1.0",
  "description": "Alpha Impact: события, значимые для вашей компании, на странице новости или контрагента",
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kommersant.ru/*",
        "*://*.vedomosti.ru/*",
        "*://*.interfax.ru/*",
        "*://*.rbc.ru/*",
        "*://*.tass.ru/*",
        "*://*.forbes.ru/*",
        "*://*.frankmedia.ru/*",
        "*://*.expert.ru/*",
        "*://*.rusprofile.ru/*",
        "*://*.checko.ru/*",
        "*://*.list-org.com/*",
        "*://*.focus.kontur.ru/*",
        "*://*.zachestnyibiznes.ru/*",
        "*://*.sbis.ru/*",
        "*://*.zakupki.gov.ru/*",
        "*://*.rts-tender.ru/*",
        "*://*.sberbank-ast.ru/*",
        "*://*.roseltorg.ru/*",
        "*://*.b2b-center.ru/*",
        "*://*.fabrikant.ru/*",
        "*://*.cbr.ru/*",
        "*://*.moex.com/*",
        "*://*.investing.com/*",
        "*://*.profinance.ru/*"
      ],
      "js": ["content.js"]
    }
  ],
  "permissions": ["sidePanel", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
