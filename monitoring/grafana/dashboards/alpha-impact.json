{
  "uid": "alpha-impact",
  "title": "Alpha Impact",
  "tags": ["alpha-impact"],
  "timezone": "browser",
  "schemaVersion": 41,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы в секунду по маршрутам",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ответы по кодам",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Задержка p95 по маршрутам",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Доля ответов 5xx за период",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(http_requests_total{status=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_requests_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Расход модели за период",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyRUB", "decimals": 2 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_cost_rub_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Доля вызовов модели из кэша",
      "gridPos": { "x": 20, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(llm_calls_total{outcome=\"cache\"}[$__range])) or vector(0)) / sum(increase(llm_calls_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Вызовы модели по задаче и исходу",
      "interval": "1m",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task, outcome) (increase(llm_calls_total[$__interval]))",
          "legendFormat": "{{task}} · {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Токены по модели",
      "interval": "1m",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, direction) (increase(llm_tokens_total[$__interval]))",
          "legendFormat": "{{model}} · {{direction}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Память API",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"api\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU API, ядра",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"api\"}[$__rate_interval])",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Строки логов с ошибками по сервисам",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({service=~\".+\"} |~ \"(?i)error|exception|traceback\" [$__auto]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Логи API",
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"api\"}"
        }
      ]
    }
  ]
}
