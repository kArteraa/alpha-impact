# База данных (compose подставляет host db / db_test внутри сети)
DB_URL=postgresql+asyncpg://alfa:alfa@localhost:5432/alfa
TEST_DB_URL=postgresql+asyncpg://alfa:alfa@localhost:5433/alfa_test

# LLM-шлюз (ключ выдаёт кейс; модели — только из allow-list, см. docs/ARCHITECTURE.md)
LLM_API_BASE=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_DAILY_BUDGET_RUB=500
LLM_BUDGET_RESERVE_SHARE=0.1
LLM_TIMEOUT_SECONDS=8
LLM_INTERACTIVE_TIMEOUT_SECONDS=12
LLM_CALL_RESERVE_RUB=1
LLM_CACHE_TTL_SECONDS=604800
MODEL_ANNOTATE=google/gemma-4-26b-a4b-it
MODEL_EXTRACT=qwen/qwen3.6-35b-a3b
MODEL_INTERPRET=deepseek/deepseek-v4.1-flash
MODEL_CRITIC=z-ai/glm-5.3-flash
MODEL_FOLLOWUP=deepseek/deepseek-v4.1-flash

# Интерпретация
RELEVANCE_THRESHOLD=0.3
CACHE_TTL_SECONDS=3600
EXTENSION_TOKEN_TTL_SECONDS=3600
NEWS_RSS_URLS='["https://www.kommersant.ru/RSS/section-economics.xml","https://www.kommersant.ru/RSS/section-business.xml","https://www.kommersant.ru/RSS/section-finance.xml","https://www.vedomosti.ru/rss/rubric/economics","https://www.vedomosti.ru/rss/rubric/finance","https://www.vedomosti.ru/rss/rubric/business","https://www.interfax.ru/rss.asp"]'

# Фронт: куда vite dev/preview проксирует запросы к API
API_PROXY_TARGET=http://localhost:8000
